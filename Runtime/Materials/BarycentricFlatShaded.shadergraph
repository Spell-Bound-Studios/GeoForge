    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "BarycentricSolver",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "if (U >= V && U >= W)\n{\n    FinalMaterialIndex = MaterialIndexA;\n    FinalIsMature = IsMatureA;\n}\nelse if (V >= W)\n{\n    FinalMaterialIndex = MaterialIndexB;\n    FinalIsMature = IsMatureB;\n}\nelse\n{\n    FinalMaterialIndex = MaterialIndexC;\n    FinalIsMature = IsMatureC;\n}"
}

